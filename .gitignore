# Composer
/vendor/mpdf/mpdf/tmp/
/vendor/mpdf/mpdf/graph_cache/
/vendor/mpdf/mpdf/ttfontdata/

# macOS / editor cruft
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# WP / misc
*.log

# Working briefs. Kept alongside the code but never committed — `git add -A`
# has swept them in twice. .git/info/exclude does not survive a clone, so the
# rule lives here. Briefs predating this line stay tracked as they are.
BRIEF-*.md
# Vendor library metadata that shouldn't be in our repo
vendor/**/.github/
vendor/**/.gitignore
vendor/**/.travis.yml
vendor/**/.gitlab-ci.yml
vendor/**/.editorconfig
# Local reference files (not committed)
_reference/
# Release artefacts
dist/

# Archived briefs under docs/ are tracked; only root working briefs stay local
!docs/briefs/BRIEF-*.md
